type": "text"}], "correct_feedback": "Correct!"}, "type": "feedback"}]}, {"id": 11, "type": "DWS", "questions": [{"id": 0, "responses": [{"selected": 0, "id": 0, "correct": 1, "_data": [{"content": "", "type": "text"}]}], "_data": [{"type": "question", "contents": [{"content": "enpe7n2le03ob10re7pdf01.pdf", "type": "pdf"}]}]}], "stimuli_ids": [], "template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": " Let's look up for some information about Scripting Languages.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "correct_feedback": "Correct!"}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Writing", "type": "skill"}]}]}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "", "type": "lesson_name"}, {"content": "Scripting Languages ", "type": "unit_name"}, {"content": 10, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "A1.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use every time you talk about scripting languages:", "type": "text"}]}, {"type": "objectives", "contents": [{"content": "Understand key information about the concepts, principles, and methodologies in simple spoken and written situations. Talk about programming techniques, use cases, kinds, and sequences in simple spoken and written situations.", "type": "primary"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures. Identifies general aspects related to Software Programming in short written or spoken conversations about past experiences.", "type": "secondary_1"}]}, {"content": "enpe7n2le03ob10re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "When to use Can and Must", "type": "heading"}, {"content": "<strong>Can</strong> and <span class=\"strong\"> Must</span> are auxiliary verbs and they are also modal verbs, we use <span class=\"strong\"> can</span> and <span class=\"strong\"> must</span> in different contexts and situations and they are very helpful verbs.", "type": "describer"}, {"content": "I can't understand the term \u201cscripting language\u201d. Can</strong> you talk to me about it?", "type": "example"}, {"content": "Users can control icons, keystrokes and some other different tools.", "type": "example"}, {"content": "<strong>Can</strong><br/>  We use <span class=\"strong\">can</span> to make a reference about <strong>abilities</strong>, we use it to say if we are able to perform actions or not, depending on the possibilities, depending on the circumstances.<br/><br/>  We use <span class=\"strong\"> can</span> to <strong>give permission</strong> or when we <strong>ask for permission</strong>, <span class=\"strong\"> can</span> is less formal and more common to use with friends or an acquaintance, for example.<br/><br/>  We use <span class=\"strong\"> can</span>  to make a <strong>deduction</strong>, when we know something in advance and then we are able to understand what possibly happens next.<br/><br/>   <strong>Structure</strong><br/><br/>  <div class=\"center_text\"><strong>Subject + Can + Verb in base form + Complement</strong><br/><br/> <span class=\"italic\"> You can test different variables.<br/> You can't test all the variables.<br/> Can you test scripting shells?</span></div><br/><br/>  <strong>NOTE:</strong> In negative form we just change <span class=\"italic\"> <strong>Can</strong></span> for <span class=\"italic\"> <strong>Can't</strong></span><br/><br/> In interrogative form we switch <span class=\"italic\"> <strong>Subject</strong></span> and <span class=\"italic\"> <strong>Can</strong></span>, can goes first and then next to it is the subject.<br/><br/>   <strong>Must</strong><br/>  We can use <span class=\"strong\">must</span> when we want to express <strong>prohibition or obligation</strong>; sometimes we can <strong>skip pending activities and do them later</strong> if possible, this may happen with things that you <span class=\"strong\">must</span> do, unlike with <span class=\"italic\">have to</span>, there is no option of skipping activities, you have to do them immediately.<br/>  We can also use <span class=\"strong\">must</span> when we want to express <strong>something is sure</strong>, when there is certainty that something happened or something has already happened.<br/><br/>  We can use <span class=\"strong\">must</span> to express <strong>moral duty</strong> in order to show respect.<br/><br/>   <strong>Structure</strong><br/><br/>  <div class=\"center_text\"><strong>Subject + Must + Verb in base form + Complement</strong><br/><br/> <span class=\"italic\">You <span class=\"strong\">must</span> allow users to log in.<br/> You <span class=\"strong\">mustn't</span> allow user to surf on that.<br/> <span class=\"strong\">Must</span> you compile data at this level?</span></div><br/><br/>  <strong>NOTE:</strong><br/> In negative form we just change <span class=\"italic\"> <strong>Must</strong></span> for <span class=\"italic\"> <strong>Mustn't  \u2013 Must Not</strong></span> In interrogative form we switch <span class=\"italic\"> <strong>Subject</strong></span> and <span class=\"italic\"> <strong>Must</strong></span>, it goes first and then next to it is the subject.", "type": "text"}, {"content": "I must know what a script is and, how do I find scripting languages in context?", "type": "example"}, {"content": "Programmer writes program codes in form of scripts that can be interpreted and executed one at a time.", "type": "example"}, {"content": "Time must bring changes in programming methods.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Action verbs: transitive and Intransitive verbs", "type": "heading"}, {"content": "The <span class=\"strong\">verb</span> is one of the most important parts of the sentence; actually there is no sentence without a verb because the verb expresses the action of the sentence, there are two types of verbs: transitive verbs and intransitive verbs", "type": "describer"}, {"content": "Scripting languages contain commands presented in a computer.", "type": "example"}, {"content": "Thus, scripting languages are in fact, programming languages.", "type": "example"}, {"content": "In <span class=\"italic\">transitive verbs</span> there is a direct object, it usually comes <strong>after</strong> the verb and <strong>the direct object receives the action of the verb</strong>, the complement in the sentence structure can work also as a direct object<br/><br/>   <strong>Structure:</strong><br/><br/>  <strong>Subject + Verb (present or past tense) + Complement (Direct object)</strong><br/> <div class=\"center_text\"><span class=\"italic\">Applications programmers create interactive features for webpages.</span> </br>Create: <strong>transitive verb</strong></br>Interactive features: <strong>direct object.</strong></li></ul> </div><br/><br/>  In <span class=\"italic\">Intransitive verbs</span>, in general there is nothing after the verb, it means that <strong>there is no object or noun receiving any action</strong>.<br/> Sometimes it could possibly have a complement but in this case when there is no direct object we can only say that there is an action taking place, sometimes we could infer that we know what the object is in advance.<br/><br/>   <strong>Structure:</strong><br/><br/>  <div class=\"center_text\"><strong>Subject + Verb (present or past tense)</strong><br/> <span class=\"italic\">Then, the program runs.</span>  </br>Run: <strong>intransitive verb</strong></li></div>", "type": "text"}, {"content": "When a user appeals to a file, the script language processor parses each line.", "type": "example"}, {"content": "I think you can exchange that information with me.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "keystroke", "type": "name"}, {"content": "every time you press a key you perform a keystroke, typing one character on a keyboard", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: As a result users can control icons, keystrokes and some other different tools as any other program features.", "type": "example"}, {"content": "enpe7n2le03ob10aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "appeal ", "type": "name"}, {"content": "to make a request of something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: A script comprises a number of text lines in a file, when a user appeals to a file, the script language processor parses each line.", "type": "example"}, {"content": "enpe7n2le03ob10aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "CoffeeScript", "type": "name"}, {"content": "a type of programming language that supports JavaScript to make it brief and readable", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: You can work with JavaScript, VBScript, AppleScript, Python, CoffeeScript and some other scripting languages.", "type": "example"}, {"content": "enpe7n2le03ob10aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "shell programming", "type": "name"}, {"content": "a computer program that contains different dialects and manipulate files, execute programs and does any necessary cleanup", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: Shell programming is the most common use of scripting language. ", "type": "example"}, {"content": "enpe7n2le03ob10aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "UNIX", "type": "name"}, {"content": "an operating system with multiuser and multitasking characteristics", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Well, shell scripting controls automating routine tasks, especially, in multiusers systems running with UNIX.", "type": "example"}, {"content": "enpe7n2le03ob10aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "pattern-matching", "type": "name"}, {"content": "examination and tracing of specific sequences of data", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Convenient features that can work for an effective pattern-matching.", "type": "example"}, {"content": "enpe7n2le03ob10aud06", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Search for extra information about scripting languages", "type": "text"}, {"content": "Identify the main differences among scripting languages. ", "type": "text"}, {"content": "Write down those aspects and make a brochure to explain them.", "type": "text"}, {"content": "Share your brochure with the class", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I search for extra information about scripting languages", "type": "text"}, {"content": "I Identify aspects that were not mentioned ", "type": "text"}, {"content": "I write down those aspects and make a brochure with them", "type": "text"}, {"content": "I share your brochure with the class", "type": "text"}]}]}